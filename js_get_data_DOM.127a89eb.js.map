'use strict';
var sum = 0;
var length = 0;
var populations = document.querySelectorAll('span');
for(var i = 0; i < populations.length; i++){
    var chunck = populations[i].innerText.split(',');
    var number = chunck.join('');
    if (typeof +number === 'number' && !Number.isNaN(+number)) {
        sum += +number;
        length++;
    }
}
var avarage = Math.round(sum / length);
document.querySelectorAll('span.total-population')[0].innerText = sum.toLocaleString('en-US');
document.querySelectorAll('span.average-population')[0].innerText = avarage.toLocaleString('en-US');

